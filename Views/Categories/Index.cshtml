@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 d-none d-md-block bg-light sidebar min-vh-100 shadow-sm">
            <div class="position-sticky pt-3">
                <h4 class="px-3 mb-4 text-success fw-bold"><i class="bi bi-receipt-cutoff"></i> SmartReceipt</h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link text-secondary mx-2 mb-2" href="/">
                            <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary mx-2 mb-2" href="/Receipt/Index">
                            <i class="bi bi-list-ul me-2"></i> All Receipts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active text-success fw-bold bg-white border rounded shadow-sm mx-2 mb-2" href="/Categories">
                            <i class="bi bi-tags me-2"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary mx-2 mb-2" href="/Home/Reports">
                            <i class="bi bi-bar-chart-line me-2"></i> Reports
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Main Content -->
        <main class="col-md-10 ms-sm-auto px-md-4 py-4 bg-light bg-opacity-25">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2"><i class="bi bi-tags me-2"></i> Categories</h1>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <!-- Add Category Form -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Category</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-action="Create">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label">Category Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="Name" placeholder="e.g. Grocery, Restaurant..." required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" name="Description" rows="2" placeholder="Category description (optional)"></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Icon</label>
                                    <select class="form-select" name="IconName">
                                        <option value="">Select...</option>
                                        <option value="shopping_cart">🛒 Shopping</option>
                                        <option value="restaurant">🍽️ Restaurant</option>
                                        <option value="local_gas_station">⛽ Fuel</option>
                                        <option value="medical_services">💊 Health</option>
                                        <option value="directions_car">🚗 Transportation</option>
                                        <option value="movie">🎬 Entertainment</option>
                                        <option value="home">🏠 Home</option>
                                        <option value="work">💼 Work</option>
                                        <option value="school">📚 Education</option>
                                        <option value="other">📦 Other</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-plus-lg me-1"></i> Add Category
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Categories List -->
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0">Existing Categories (@Model.Categories.Count)</h5>
                        </div>
                        <div class="card-body p-0">
                            @if (Model.Categories.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr class="border-bottom">
                                                <th>Icon</th>
                                                <th>Category Name</th>
                                                <th>Description</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var category in Model.Categories)
                                            {
                                                <tr>
                                                    <td>
                                                        @switch (category.IconName)
                                                        {
                                                            case "shopping_cart":
                                                                <span>🛒</span>
                                                                break;
                                                            case "restaurant":
                                                                <span>🍽️</span>
                                                                break;
                                                            case "local_gas_station":
                                                                <span>⛽</span>
                                                                break;
                                                            case "medical_services":
                                                                <span>💊</span>
                                                                break;
                                                            case "directions_car":
                                                                <span>🚗</span>
                                                                break;
                                                            case "movie":
                                                                <span>🎬</span>
                                                                break;
                                                            case "home":
                                                                <span>🏠</span>
                                                                break;
                                                            case "work":
                                                                <span>💼</span>
                                                                break;
                                                            case "school":
                                                                <span>📚</span>
                                                                break;
                                                            default:
                                                                <span>📦</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td><strong>@category.Name</strong></td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(category.Description))
                                                        {
                                                            <span class="text-muted">@category.Description</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <form method="post" asp-action="Delete" asp-route-id="@category.Id" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <p>No categories added yet. Start by adding a new category!</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
