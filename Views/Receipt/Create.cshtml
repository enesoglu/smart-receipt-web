@model ReceiptEditViewModel
@{
    ViewData["Title"] = "Add Receipt";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2 py-4">
            <!-- Error Messages -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Receipt</h4>
                </div>
                <div class="card-body p-4">
                    <!-- OCR Scan Section -->
                    <div class="mb-4">
                        <h5><i class="bi bi-camera me-2"></i>Scan Receipt (OCR)</h5>
                        <div class="border rounded p-3 bg-light">
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Upload Receipt Image</label>
                                        <input type="file" class="form-control" id="receiptImage" accept="image/*">
                                        <small class="text-muted">Take a photo or upload an image of your receipt</small>
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button type="button" class="btn btn-primary w-100 mb-3" id="scanBtn">
                                        <i class="bi bi-cloud-upload me-2"></i>Scan with Azure OCR
                                    </button>
                                </div>
                            </div>

                            <!-- Loading -->
                            <div id="scanLoading" class="text-center py-3" style="display:none;">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Scanning...</span>
                                </div>
                                <p class="mt-2 mb-0 text-muted">Scanning with Azure OCR... This may take a few seconds.</p>
                            </div>

                            <!-- Success Message -->
                            <div id="scanSuccess" class="alert alert-success" style="display:none;">
                                <i class="bi bi-check-circle me-2"></i>
                                <strong>OCR Success!</strong> Store name and total amount have been auto-filled.
                            </div>

                            <!-- Scanned Text (Collapsible) -->
                            <div id="scanResult" class="mt-3" style="display:none;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-muted small">
                                        <i class="bi bi-file-text me-1"></i>Scanned Text (Details)
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleScannedText">
                                        <i class="bi bi-chevron-down"></i> Show
                                    </button>
                                </div>
                                <div id="scannedTextContainer" style="display:none;">
                                    <div class="border rounded bg-white p-2" style="max-height: 200px; overflow-y: auto;">
                                        <pre id="scannedText" class="mb-0" style="white-space: pre-wrap; font-size: 12px;"></pre>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <form method="post" asp-action="Create">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="StoreName" class="form-label">Store Name <span class="text-danger">*</span></label>
                                    <input asp-for="StoreName" class="form-control" id="storeNameInput" placeholder="e.g. BİM, A101, Migros..." required>
                                    <span asp-validation-for="StoreName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Date" class="form-label">Date <span class="text-danger">*</span></label>
                                    <input type="date" asp-for="Date" class="form-control" id="dateInput" required>
                                    <span asp-validation-for="Date" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TotalAmount" class="form-label">Total Amount (₺) <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text">₺</span>
                                        <input type="number" step="0.01" asp-for="TotalAmount" class="form-control" id="totalAmountInput" placeholder="0.00" required>
                                    </div>
                                    <span asp-validation-for="TotalAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CategoryId" class="form-label">Category</label>
                                    <select asp-for="CategoryId" class="form-select">
                                        <option value="">-- Select Category --</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    </select>
                                    <small class="text-muted">Optional: select a category</small>
                                </div>
                            </div>
                        </div>


                        <input type="hidden" asp-for="ImagePath" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a href="/Receipt/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>Save Receipt
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Toggle scanned text visibility
        document.getElementById('toggleScannedText').addEventListener('click', function() {
            const container = document.getElementById('scannedTextContainer');
            const icon = this.querySelector('i');
            if (container.style.display === 'none') {
                container.style.display = 'block';
                icon.className = 'bi bi-chevron-up';
                this.innerHTML = '<i class="bi bi-chevron-up"></i> Hide';
            } else {
                container.style.display = 'none';
                icon.className = 'bi bi-chevron-down';
                this.innerHTML = '<i class="bi bi-chevron-down"></i> Show';
            }
        });

        // Parse OCR text to extract store name and total - Supports different receipt formats
        function parseOcrText(text) {
            const result = {
                storeName: null,
                totalAmount: null,
                date: null
            };

            if (!text) return result;

            const lines = text.split('\n').map(line => line.trim()).filter(line => line.length > 0);

            // 1. Find store name
            // Priority 1: Find line containing "A.Ş." (company name)
            for (let i = 0; i < Math.min(10, lines.length); i++) {
                const line = lines[i];
                if (line.includes('A.Ş.') || line.includes('A.S.')) {
                    result.storeName = line;
                    break;
                }
            }

            // Priority 2: First meaningful line (if A.Ş. not found)
            if (!result.storeName && lines.length > 0) {
                for (let i = 0; i < Math.min(3, lines.length); i++) {
                    const line = lines[i];
                    if (line.length > 5 && !line.match(/^\d+$/) && !line.toLowerCase().includes('mgz')) {
                        result.storeName = line;
                        break;
                    }
                }
            }

            // 2. Find TOPLAM/Toplam (Total)
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                const lineUpper = line.toUpperCase();

                // Excluded: TOPKDV, Toplam KDV (Total VAT)
                const isToplamLine = lineUpper.includes('TOPLAM') || line.includes('Toplam');
                const isExcluded = lineUpper.includes('TOPKDV') || lineUpper.includes('TOPLAM KDV') || line.includes('Toplam KDV');

                if (isToplamLine && !isExcluded) {
                    const starMatch = line.match(/\*\s*([\d.,]+)/);
                    if (starMatch) {
                        const cleanAmount = starMatch[1].replace(/\./g, '').replace(',', '.');
                        const parsed = parseFloat(cleanAmount);
                        if (!isNaN(parsed) && parsed > 0) {
                            result.totalAmount = parsed;
                            break;
                        }
                    }

                    const numMatches = line.match(/[\d.,]+/g);
                    if (numMatches) {
                        for (let j = numMatches.length - 1; j >= 0; j--) {
                            const cleanAmount = numMatches[j].replace(/\./g, '').replace(',', '.');
                            const parsed = parseFloat(cleanAmount);
                            if (!isNaN(parsed) && parsed > 10) {
                                result.totalAmount = parsed;
                                break;
                            }
                        }
                        if (result.totalAmount) break;
                    }

                    if (!result.totalAmount && i + 1 < lines.length) {
                        const nextLine = lines[i + 1];
                        const nextStarMatch = nextLine.match(/\*\s*([\d.,]+)/);
                        if (nextStarMatch) {
                            const cleanAmount = nextStarMatch[1].replace(/\./g, '').replace(',', '.');
                            const parsed = parseFloat(cleanAmount);
                            if (!isNaN(parsed) && parsed > 0) {
                                result.totalAmount = parsed;
                                break;
                            }
                        } else {
                            const numMatch = nextLine.match(/([\d.,]+)/);
                            if (numMatch) {
                                const cleanAmount = numMatch[1].replace(/\./g, '').replace(',', '.');
                                const parsed = parseFloat(cleanAmount);
                                if (!isNaN(parsed) && parsed > 10) {
                                    result.totalAmount = parsed;
                                    break;
                                }
                            }
                        }
                    }
                }
            }

            // 3. TARİH/Tarih satırını bul
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i];
                const lineUpper = line.toUpperCase();

                if (lineUpper.includes('TARİH') || lineUpper.includes('TARIH')) {
                    let dateMatch = line.match(/(\d{2})\.(\d{2})\.(\d{4})/);
                    if (dateMatch) {
                        result.date = `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
                        break;
                    }
                    if (i + 1 < lines.length) {
                        dateMatch = lines[i + 1].match(/(\d{2})\.(\d{2})\.(\d{4})/);
                        if (dateMatch) {
                            result.date = `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
                            break;
                        }
                    }
                }
            }

            if (!result.date) {
                for (let i = 0; i < lines.length; i++) {
                    const dateMatch = lines[i].match(/(\d{2})\.(\d{2})\.(\d{4})/);
                    if (dateMatch) {
                        result.date = `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
                        break;
                    }
                }
            }

            return result;
        }

        // Scan button click handler
        document.getElementById('scanBtn').addEventListener('click', async function() {
            const fileInput = document.getElementById('receiptImage');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('Please select a receipt photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('image', fileInput.files[0]);

            // Show loading, hide others
            document.getElementById('scanLoading').style.display = 'block';
            document.getElementById('scanResult').style.display = 'none';
            document.getElementById('scanSuccess').style.display = 'none';
            this.disabled = true;

            try {
                const response = await fetch('/Receipt/ScanTest', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                // Hide loading
                document.getElementById('scanLoading').style.display = 'none';
                this.disabled = false;

                if (result.success && result.data) {
                    const rawText = result.data.rawText || result.data.RawText || '';

                    if (rawText && rawText.length > 0) {
                        // Show scanned text
                        document.getElementById('scanResult').style.display = 'block';
                        document.getElementById('scannedText').textContent = rawText;

                        // Parse the OCR text
                        const parsed = parseOcrText(rawText);

                        // Auto-fill form fields
                        if (parsed.storeName) {
                            document.getElementById('storeNameInput').value = parsed.storeName;
                        }
                        if (parsed.totalAmount) {
                            document.getElementById('totalAmountInput').value = parsed.totalAmount.toFixed(2);
                        }
                        if (parsed.date) {
                            document.getElementById('dateInput').value = parsed.date;
                        }

                        // Show success message
                        document.getElementById('scanSuccess').style.display = 'block';

                        // Scroll to form
                        document.getElementById('storeNameInput').scrollIntoView({ behavior: 'smooth', block: 'center' });

                    } else {
                        alert('No text found in the image. Please try with a clearer photo.');
                    }
                } else {
                    alert(result.message || 'OCR processing failed.');
                }
            } catch (error) {
                document.getElementById('scanLoading').style.display = 'none';
                this.disabled = false;
                alert('Connection error: ' + error.message);
            }
        });

        // Set today's date as default
        if (!document.getElementById('dateInput').value) {
            document.getElementById('dateInput').valueAsDate = new Date();
        }
    </script>
}

