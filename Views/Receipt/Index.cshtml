@model List<ReceiptDto>
@{
    ViewData["Title"] = "All Receipts";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 d-none d-md-block bg-light sidebar min-vh-100 shadow-sm">
            <div class="position-sticky pt-3">
                <h4 class="px-3 mb-4 text-success fw-bold"><i class="bi bi-receipt-cutoff"></i> SmartReceipt</h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link text-secondary mx-2 mb-2" href="/">
                            <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active text-success fw-bold bg-white border rounded shadow-sm mx-2 mb-2" href="/Receipt/Index">
                            <i class="bi bi-list-ul me-2"></i> All Receipts
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary mx-2 mb-2" href="/Categories">
                            <i class="bi bi-tags me-2"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary mx-2 mb-2" href="/Home/Reports">
                            <i class="bi bi-bar-chart-line me-2"></i> Reports
                        </a>
                    </li>
                </ul>

                <div class="px-3 mt-4">
                    <button class="btn btn-success w-100 shadow-sm" data-bs-toggle="modal" data-bs-target="#addReceiptModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Receipt
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <main class="col-md-10 ms-sm-auto px-md-4 py-4 bg-light bg-opacity-25">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">All Receipts</h1>
            </div>

            <p class="text-muted">View and manage all your receipts.</p>

            <!-- Search and Filters -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="input-group mb-3">
                        <i class="bi bi-search input-group-text bg-white border-end-0"></i>
                        <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Search by store name or tags...">
                    </div>
                </div>
            </div>

            <!-- Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Receipts Table -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">Receipts (@Model.Count)</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="receiptsTable">
                        <thead>
                            <tr class="border-bottom">
                                <th>Store Name</th>
                                <th>Date</th>
                                <th>Category</th>
                                <th>Total Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count > 0)
                            {
                                @foreach (var receipt in Model.OrderByDescending(r => r.Date))
                                {
                                    <tr>
                                        <td>
                                            <strong>@receipt.StoreName</strong>
                                        </td>
                                        <td>
                                            @receipt.Date.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(receipt.CategoryName))
                                            {
                                                <span class="badge bg-info">@receipt.CategoryName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <strong class="text-success">₺@receipt.TotalAmount.ToString("N2")</strong>
                                        </td>
                                        <td>
                                            <a href="/Receipt/Edit/@receipt.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" action="/Receipt/Delete/@receipt.Id" style="display:inline;" onsubmit="return confirm('Are you sure?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        <p>No receipts yet. Start by adding your first receipt!</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Add Receipt Modal -->
<div class="modal fade" id="addReceiptModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Add New Receipt</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <!-- Error Alert -->
            <div id="errorAlert" class="alert alert-danger alert-dismissible fade show m-3" role="alert" style="display:none;">
                <span id="errorMessage"></span>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <form id="addReceiptForm">
                <div class="modal-body">
                    <!-- OCR Scan Section -->
                    <div class="mb-4 p-3 bg-light rounded border">
                        <h6 class="fw-bold mb-3"><i class="bi bi-camera me-2"></i>Scan Receipt (OCR)</h6>
                        <div class="row g-2">
                            <div class="col-md-8">
                                <input type="file" class="form-control" id="ocrImage" accept="image/*">
                                <small class="text-muted">Upload a receipt photo and scan with Azure OCR</small>
                            </div>
                            <div class="col-md-4">
                                <button type="button" class="btn btn-primary w-100" id="scanOcrBtn">
                                    <i class="bi bi-cloud-upload me-1"></i> Scan
                                </button>
                            </div>
                        </div>
                        <!-- OCR Loading -->
                        <div id="ocrLoading" class="text-center mt-3" style="display:none;">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2">Scanning with Azure OCR...</span>
                        </div>
                        <!-- OCR Success -->
                        <div id="ocrSuccess" class="alert alert-success mt-3 mb-0 py-2" style="display:none;">
                            <i class="bi bi-check-circle me-1"></i> <strong>Success!</strong> Store name and total amount have been filled.
                        </div>
                        <!-- OCR Result Preview (Collapsible) -->
                        <div id="ocrResult" class="mt-3" style="display:none;">
                            <a class="text-muted small" data-bs-toggle="collapse" href="#ocrTextCollapse" role="button">
                                <i class="bi bi-chevron-down"></i> Show scanned text
                            </a>
                            <div class="collapse mt-2" id="ocrTextCollapse">
                                <div class="border rounded bg-white p-2" style="max-height: 150px; overflow-y: auto;">
                                    <pre id="ocrText" class="mb-0" style="white-space: pre-wrap; font-size: 11px;"></pre>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label">Store Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="storeName" list="storeList" placeholder="e.g. BİM, A101, Migros..." required>
                                <datalist id="storeList">
                                    <!-- Will be populated via JavaScript -->
                                </datalist>
                                <small class="text-muted">Select from existing stores or type a new store name</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="receiptDate" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Total Amount (₺) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₺</span>
                                    <input type="number" step="0.01" class="form-control" id="totalAmount" placeholder="0.00" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" id="categoryId">
                                    <option value="">Select Category...</option>
                                    <!-- Will be populated via JavaScript -->
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Save Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Set today's date as default
    document.getElementById('receiptDate').valueAsDate = new Date();

    // Load categories and stores on page load
    document.addEventListener('DOMContentLoaded', async function() {
        await loadCategories();
        await loadStores();
    });

    async function loadCategories() {
        try {
            const response = await fetch('/Categories/GetAll');
            const result = await response.json();
            if (result.success && result.data) {
                const select = document.getElementById('categoryId');
                result.data.forEach(cat => {
                    const option = document.createElement('option');
                    option.value = cat.id;
                    option.textContent = cat.name;
                    select.appendChild(option);
                });
            }
        } catch (error) {
            console.error('Error loading categories:', error);
        }
    }

    async function loadStores() {
        try {
            const response = await fetch('/Categories/GetStores');
            const result = await response.json();
            if (result.success && result.data) {
                const datalist = document.getElementById('storeList');
                result.data.forEach(store => {
                    const option = document.createElement('option');
                    option.value = store.name;
                    datalist.appendChild(option);
                });
            }
        } catch (error) {
            console.error('Error loading stores:', error);
        }
    }

    // OCR Parsing Function - Supports different receipt formats
    function parseOcrText(text) {
        const result = { storeName: null, totalAmount: null, date: null };
        if (!text) return result;

        const lines = text.split('\n').map(line => line.trim()).filter(line => line.length > 0);

        // 1. Find store name
        // Priority 1: Find line containing "A.Ş." (company name)
        for (let i = 0; i < Math.min(10, lines.length); i++) {
            const line = lines[i];
            if (line.includes('A.Ş.') || line.includes('A.S.')) {
                result.storeName = line;
                break;
            }
        }

        // Priority 2: First meaningful line (if A.Ş. not found)
        if (!result.storeName && lines.length > 0) {
            for (let i = 0; i < Math.min(3, lines.length); i++) {
                const line = lines[i];
                if (line.length > 5 && !line.match(/^\d+$/) && !line.toLowerCase().includes('mgz')) {
                    result.storeName = line;
                    break;
                }
            }
        }

        // 2. Find TOPLAM/Toplam (Total) and get amount
        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];
            const lineUpper = line.toUpperCase();

            // Find "TOPLAM" or "Toplam" line
            // Excluded: TOPKDV, Toplam KDV, TOPLAM KDV (Total VAT)
            const isToplamLine = lineUpper.includes('TOPLAM') || line.includes('Toplam');
            const isExcluded = lineUpper.includes('TOPKDV') || lineUpper.includes('TOPLAM KDV') || line.includes('Toplam KDV');

            if (isToplamLine && !isExcluded) {
                // Get number after * symbol on same line (e.g., "Toplam *1113,35")
                const starMatch = line.match(/\*\s*([\d.,]+)/);
                if (starMatch) {
                    const cleanAmount = starMatch[1].replace(/\./g, '').replace(',', '.');
                    const parsed = parseFloat(cleanAmount);
                    if (!isNaN(parsed) && parsed > 0) {
                        result.totalAmount = parsed;
                        break;
                    }
                }

                // Check for number on same line (e.g., "Toplam 1113,35")
                const numMatches = line.match(/[\d.,]+/g);
                if (numMatches) {
                    for (let j = numMatches.length - 1; j >= 0; j--) {
                        const cleanAmount = numMatches[j].replace(/\./g, '').replace(',', '.');
                        const parsed = parseFloat(cleanAmount);
                        if (!isNaN(parsed) && parsed > 10) { // Must be > 10 (small numbers may be VAT rates)
                            result.totalAmount = parsed;
                            break;
                        }
                    }
                    if (result.totalAmount) break;
                }

                // If no amount on same line, check next line
                if (!result.totalAmount && i + 1 < lines.length) {
                    const nextLine = lines[i + 1];
                    const nextStarMatch = nextLine.match(/\*\s*([\d.,]+)/);
                    if (nextStarMatch) {
                        const cleanAmount = nextStarMatch[1].replace(/\./g, '').replace(',', '.');
                        const parsed = parseFloat(cleanAmount);
                        if (!isNaN(parsed) && parsed > 0) {
                            result.totalAmount = parsed;
                            break;
                        }
                    } else {
                        const numMatch = nextLine.match(/([\d.,]+)/);
                        if (numMatch) {
                            const cleanAmount = numMatch[1].replace(/\./g, '').replace(',', '.');
                            const parsed = parseFloat(cleanAmount);
                            if (!isNaN(parsed) && parsed > 10) {
                                result.totalAmount = parsed;
                                break;
                            }
                        }
                    }
                }
            }
        }

        // 3. Find TARİH/Tarih (Date) line
        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];
            const lineUpper = line.toUpperCase();

            if (lineUpper.includes('TARİH') || lineUpper.includes('TARIH')) {
                // Check for date on same line
                let dateMatch = line.match(/(\d{2})\.(\d{2})\.(\d{4})/);
                if (dateMatch) {
                    result.date = `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
                    break;
                }
                // Check next line for date
                if (i + 1 < lines.length) {
                    dateMatch = lines[i + 1].match(/(\d{2})\.(\d{2})\.(\d{4})/);
                    if (dateMatch) {
                        result.date = `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
                        break;
                    }
                }
            }
        }

        // If date still not found, search all lines for date format
        if (!result.date) {
            for (let i = 0; i < lines.length; i++) {
                const dateMatch = lines[i].match(/(\d{2})\.(\d{2})\.(\d{4})/);
                if (dateMatch) {
                    result.date = `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
                    break;
                }
            }
        }

        return result;
    }

    // OCR Scan Button
    document.getElementById('scanOcrBtn').addEventListener('click', async function() {
        const fileInput = document.getElementById('ocrImage');
        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Please select a receipt photo first.');
            return;
        }

        const formData = new FormData();
        formData.append('image', fileInput.files[0]);

        // Show loading
        document.getElementById('ocrLoading').style.display = 'block';
        document.getElementById('ocrSuccess').style.display = 'none';
        document.getElementById('ocrResult').style.display = 'none';
        this.disabled = true;

        try {
            const response = await fetch('/Receipt/ScanTest', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            document.getElementById('ocrLoading').style.display = 'none';
            this.disabled = false;

            if (result.success && result.data) {
                const rawText = result.data.rawText || result.data.RawText || '';

                if (rawText && rawText.length > 0) {
                    // Show result
                    document.getElementById('ocrResult').style.display = 'block';
                    document.getElementById('ocrText').textContent = rawText;

                    // Parse OCR text
                    const parsed = parseOcrText(rawText);

                    // Auto-fill form fields
                    if (parsed.storeName) {
                        document.getElementById('storeName').value = parsed.storeName;
                    }
                    if (parsed.totalAmount) {
                        document.getElementById('totalAmount').value = parsed.totalAmount.toFixed(2);
                    }
                    if (parsed.date) {
                        document.getElementById('receiptDate').value = parsed.date;
                    }

                    // Store parsed items from API response (if available)
                    if (result.data.items && result.data.items.length > 0) {
                        window.parsedItems = result.data.items;
                        console.log('Parsed items from API:', window.parsedItems);
                    } else {
                        window.parsedItems = [];
                    }

                    // Show success
                    document.getElementById('ocrSuccess').style.display = 'block';
                } else {
                    alert('No text found in the image.');
                }
            } else {
                alert(result.message || 'OCR processing failed.');
            }
        } catch (error) {
            document.getElementById('ocrLoading').style.display = 'none';
            this.disabled = false;
            alert('Connection error: ' + error.message);
        }
    });

    // Search functionality
    document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#receiptsTable tbody tr');

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(searchTerm) ? '' : 'none';
        });
    });

    // Form submission
    document.getElementById('addReceiptForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const storeName = document.getElementById('storeName').value;
        const receiptDate = document.getElementById('receiptDate').value;
        const totalAmount = document.getElementById('totalAmount').value;
        const categoryId = document.getElementById('categoryId')?.value || null;

        // Hide error alert
        document.getElementById('errorAlert').style.display = 'none';

        if (!storeName || !receiptDate || !totalAmount) {
            showError('Please fill all required fields');
            return;
        }

        // Get parsed items if available
        let items = [];
        if (window.parsedItems && window.parsedItems.length > 0) {
            items = window.parsedItems;
        }

        const request = {
            storeName: storeName,
            date: new Date(receiptDate).toISOString(),
            totalAmount: parseFloat(totalAmount),
            categoryId: categoryId ? parseInt(categoryId) : null,
            imagePath: null,
            items: items
        };

        try {
            const response = await fetch('/Receipt/CreateAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'include',
                body: JSON.stringify(request)
            });

            if (response.status === 401) {
                window.location.href = '/Auth/Login';
                return;
            }

            const result = await response.json();

            if (result.success) {
                alert('Receipt added successfully!');
                document.getElementById('addReceiptForm').reset();
                const modal = bootstrap.Modal.getInstance(document.getElementById('addReceiptModal'));
                modal.hide();
                location.reload();
            } else {
                showError(result.message || 'Failed to add receipt');
            }
        } catch (error) {
            console.error('Error:', error);
            showError('Network error. Please try again.');
        }
    });

    function showError(message) {
        document.getElementById('errorMessage').textContent = message;
        document.getElementById('errorAlert').style.display = 'block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
</script>

